{
  "config": {
    "abort": {
      "no_devices_found": "[%key:common::config_flow::abort::no_devices_found%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "flow_title": "Napoleon Fireplace ({short_address})",
    "step": {
      "select_features": {
        "data": {
          "aux": "[%key:component::napoleon_efire::entity::switch::aux::name%]",
          "blower": "[%key:component::napoleon_efire::entity::fan::blower::name%]",
          "night_light": "[%key:component::napoleon_efire::entity::light::night_light::name%]",
          "split_flow": "[%key:component::napoleon_efire::entity::switch::split_flow::name%]"
        },
        "data_description": {
          "aux": "Select if you want to control the AUX relay on your fireplace",
          "night_light": "The light mounted at the top inside the firebox",
          "split_flow": "Select if your fireplace has a primary and secondary burner (eg. front/back)"
        },
        "description": "Select the features your fireplace is equipped with"
      },
      "user": {
        "data": {
          "address": "[%key:common::config_flow::data::device%]",
          "password": "[%key:common::config_flow::data::password%]"
        },
        "description": "Select your fireplace and enter the password. The default password is '0000'."
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "aux": "[%key:component::napoleon_efire::entity::switch::aux::name%]",
          "blower": "[%key:component::napoleon_efire::entity::fan::blower::name%]",
          "led_lights": "LED Lights",
          "night_light": "[%key:component::napoleon_efire::entity::light::night_light::name%]",
          "split_flow": "[%key:component::napoleon_efire::entity::switch::split_flow::name%]"
        },
        "data_description": {
          "aux": "[%key:component::napoleon_efire::config::step::select_features::data_description::aux%]",
          "led_lights": "The LED light kit, if one is fitted. Untick this if the LED controls appear to do nothing",
          "night_light": "[%key:component::napoleon_efire::config::step::select_features::data_description::night_light%]",
          "split_flow": "[%key:component::napoleon_efire::config::step::select_features::data_description::split_flow%]"
        },
        "description": "Change the features your fireplace is equipped with. Entities for features you untick will stop being provided."
      }
    }
  },
  "entity": {
    "fan": {
      "blower": {
        "name": "Blower"
      }
    },
    "light": {
      "flame": {
        "name": "Flame"
      },
      "night_light": {
        "name": "Night Light"
      }
    },
    "switch": {
      "aux": {
        "name": "Aux"
      },
      "continuous_pilot": {
        "name": "Continuous pilot"
      },
      "split_flow": {
        "name": "Split flow"
      }
    }
  }
}
